# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Runtime environment: "development" | "production"
ENVIRONMENT=development

# Secret used to sign JWTs. Generate a strong one for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production the app refuses to start with the insecure default.
SECRET_KEY=change-me-in-production

# Database.
# Local dev: SQLite file (below). Production: use PostgreSQL — e.g. on Railway,
# reference the Postgres service's URL: DATABASE_URL=${{Postgres.DATABASE_URL}}
# (postgres:// and postgresql:// URLs are auto-adapted to the psycopg driver).
DATABASE_URL=sqlite:///./im_telligence.db

# Where uploaded lesson PDFs are stored. In production point this at a PERSISTENT
# disk (e.g. a Railway Volume mounted at /data) so uploads survive redeploys:
#   UPLOAD_DIR=/data/files
UPLOAD_DIR=./storage/files

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (CORS). In production set the
# exact frontend URL(s), e.g. CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Cookies. In production over HTTPS set COOKIE_SECURE=true.
#
# Prefer serving the API from a subdomain of the app's own domain
# (app: https://ai-imtelligence.com, API: https://api.ai-imtelligence.com).
# They are then the same site, COOKIE_SAMESITE=lax works, and the refresh
# cookie is not a third-party cookie — which browsers increasingly refuse.
# Refresh is cookie-only, so a blocked cookie signs teachers out the moment
# their 15-minute access token expires, mid-lesson.
#
# Only when the API genuinely sits on a different domain (e.g. two Railway
# services, *.up.railway.app) is COOKIE_SAMESITE=none needed, and it requires
# COOKIE_SECURE=true. Treat that as a temporary arrangement.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# First-run super-admin bootstrap. On a fresh DB with no super-admin, if both of
# these are set an active super-admin is created at startup (no-op once one
# exists). Essential for a fresh production database — you can't log in without it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# Teacher AI assistant.
# AI_PROVIDER picks the active model: mock | groq | grok | openai | anthropic.
# If the chosen provider's key is empty, the app falls back to "mock" (no key
# needed) so the chat still works in development.
# NOTE: "groq" (groq.com, keys gsk_...) and "grok" (xAI, keys xai-...) are
# different providers — don't confuse them.
AI_PROVIDER=groq
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_MODEL=grok-2-latest
OPENAI_MODEL=gpt-4o

# --- Teacher assistant: visual slide inspection --------------------------- #
# When enabled AND AI_PROVIDER=openai (the only provider wired for images), each
# teacher question also sends a rendered image of the slide they are viewing, so
# the assistant can read wiring diagrams, MakeCode/Scratch blocks and
# screenshots. Set to false to roll back to text-only answers; everything else
# about the assistant is unchanged. Only the visible slide is sent, never the
# whole PDF, and the image is held in memory (no public URL).
AI_TEACHER_VISION_ENABLED=true
# Hard ceiling on the encoded slide image. If a page cannot be compressed under
# this, the request falls back to text-only rather than sending a huge payload.
AI_MAX_IMAGE_BYTES=1500000
# Image fidelity sent to the model: low | high | auto. "high" keeps small pin
# labels and block text legible.
AI_IMAGE_DETAIL=high
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email delivery for DB backups ---
# Resend (https://resend.com) is preferred for production. If RESEND_API_KEY is
# set, backups are emailed via Resend; otherwise the SMTP settings below are
# used. For production set RESEND_FROM to a verified-domain address; the shared
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# SMTP — fallback for emailing the database backup (download works without it).
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com,
# password=<16-char app password, no spaces>, tls=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- Automated daily database backup ---
# When enabled, the server emails a full DB backup to BACKUP_EMAIL_TO every
# BACKUP_INTERVAL_HOURS, using the email provider resolved above.
BACKUP_EMAIL_ENABLED=false
BACKUP_EMAIL_TO=
BACKUP_INTERVAL_HOURS=24

# --- Admin notifications ---
# Where teacher lesson-access requests are emailed. If empty, all super-admin
# account emails are used instead.
ADMIN_EMAIL=

# --- Sign-in location lookup (Security Logs) ---
# Off by default: with "none" the Security Logs screen shows no location at all,
# which is the honest output. An IP resolves to a city at best — often the
# carrier's egress point — so treat it as "this sign-in came from somewhere
# unusual", never as a person's whereabouts.
#
#   none     no lookup, no location shown
#   http     calls a third-party service — which hands that service your users'
#            IP addresses. Set GEOIP_API_URL, {ip} is substituted:
#            https://ipapi.co/{ip}/json/   (free tier, no key, non-commercial)
#   maxmind  reads a local GeoLite2 .mmdb file; nothing leaves the server.
#            Needs `pip install geoip2` and GEOIP_DB_PATH.
#
# Lookups never run during a sign-in — a slow or dead provider must not delay
# somebody's login — so they happen when an admin opens the Security Logs page,
# and each address is resolved once and kept on the row.
GEOIP_PROVIDER=none
GEOIP_API_URL=
GEOIP_DB_PATH=

# --- Reading slide images (Gemini) ---
# A separate model that READS a slide and writes down what is on it; the
# answering model then works from that text. Needed because Year 1 and the lower
# Year 2 grades teach block coding, where the code IS a picture and a PDF of it
# has no usable text layer — the assistant was being asked about slides it could
# not read a word of.
#
# Each slide is read once and the result kept, so this costs one call per slide
# for the life of the PDF, not one per question. Everything fails soft: a bad
# key, a model name that does not resolve, or a timeout costs the teacher only
# the visual detail, never an error.
#
# Check the model name actually resolves with POST /api/ai/vision/probe as a
# super-admin — it returns the provider's own message plus every model your key
# can use. A name that does not exist otherwise fails silently forever.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_ENABLED=false
# Year 2 turns to Python above this grade, where the text layer already works.
VISION_YEAR2_MAX_GRADE=6
